# Video Campaign Agent - Environment Configuration

# Claude API (for vision analysis and orchestration)
CLAUDE_API_KEY=sk-ant-xxx

# OpenRouter API (for image generation)
OPENROUTER_API_KEY=xxx

# Brand Configuration
BRAND_NAME="Your Brand Name"
PRIMARY_COLOR="#0066CC"
SECONDARY_COLOR="#FFB400"
LOGO_PATH=/path/to/logo.png

# Meta (Facebook/Instagram) Configuration
META_ACCESS_TOKEN=xxx
META_BUSINESS_ID=xxx

# Google Ads Configuration
GOOGLE_ADS_DEVELOPER_TOKEN=xxx
GOOGLE_ADS_CUSTOMER_ID=xxx

# Twitter/X Configuration
TWITTER_BEARER_TOKEN=xxx
TWITTER_API_KEY=xxx
TWITTER_API_SECRET=xxx

# Agent Configuration
MAX_VIDEOS=20
VIDEOS_TO_SELECT=3
VERSIONS_PER_VIDEO=3
AUTO_PUBLISH=true
ENABLE_LOGGING=true

# Feature Flags
ENABLE_INTRO_GENERATION=true
ENABLE_OUTRO_GENERATION=true
ENABLE_AUTO_BRANDING=true

# Video Processing
VIDEO_OUTPUT_FORMAT=mp4
INTRO_DURATION_SECONDS=3
OUTRO_DURATION_SECONDS=2
MIN_VIDEO_QUALITY_SCORE=0.6
MIN_AUDIO_QUALITY_SCORE=0.7
MIN_RESOLUTION_HEIGHT=720

# Platform Settings
ENABLE_META_PUBLISHING=true
ENABLE_GOOGLE_ADS_PUBLISHING=true
ENABLE_TWITTER_PUBLISHING=true
