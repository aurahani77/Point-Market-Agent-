{
  "brand_defaults": {
    "colors": {
      "primary": "#0066CC",
      "secondary": "#FFB400",
      "accent": "#FF6B35",
      "text_dark": "#1A1A1A",
      "text_light": "#FFFFFF",
      "background_dark": "#121212",
      "background_light": "#F5F5F5"
    },
    "typography": {
      "font_family_primary": "Arial",
      "font_family_secondary": "Helvetica",
      "sizes": {
        "heading_1": 72,
        "heading_2": 48,
        "heading_3": 36,
        "body": 24,
        "caption": 16
      }
    },
    "spacing": {
      "padding_large": 32,
      "padding_medium": 16,
      "padding_small": 8,
      "margin_large": 24,
      "margin_medium": 12,
      "margin_small": 6
    },
    "elements": {
      "watermark": {
        "enabled": true,
        "position": "bottom_right",
        "opacity": 0.3,
        "text": "© Your Brand"
      },
      "logo": {
        "enabled": true,
        "position": "top_left",
        "size": "small",
        "opacity": 0.8
      },
      "border": {
        "enabled": false,
        "color": "#0066CC",
        "width": 2
      }
    },
    "video_dimensions": {
      "vertical": {
        "width": 1080,
        "height": 1920,
        "aspect_ratio": "9:16",
        "platform": "Instagram Stories, Reels, TikTok"
      },
      "square": {
        "width": 1080,
        "height": 1080,
        "aspect_ratio": "1:1",
        "platform": "Instagram Feed, Facebook Feed"
      },
      "horizontal": {
        "width": 1920,
        "height": 1080,
        "aspect_ratio": "16:9",
        "platform": "YouTube, Google Ads"
      }
    },
    "animations": {
      "transition": "fade",
      "transition_duration": 300,
      "text_animation": "fade_in_slide",
      "text_animation_duration": 500
    },
    "audio": {
      "default_music_genre": "uplifting_corporate",
      "default_volume": 0.7,
      "intro_audio_duration": 3,
      "outro_audio_duration": 2
    },
    "cta": {
      "primary": {
        "text": "Learn More",
        "url": "https://example.com",
        "color": "#0066CC",
        "text_color": "#FFFFFF"
      },
      "secondary": {
        "text": "Follow Us",
        "url": "https://instagram.com/yourhandle",
        "color": "#FFB400",
        "text_color": "#1A1A1A"
      }
    }
  }
}
