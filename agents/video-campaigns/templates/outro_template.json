{
  "outro_template": {
    "version": "1.0",
    "duration": 2,
    "format": "mp4",
    "styles": [
      {
        "name": "call_to_action",
        "description": "Focus on CTA button with contact info",
        "background": "gradient_overlay",
        "cta_button": true,
        "music_intensity": "medium",
        "social_icons": true
      },
      {
        "name": "subscription",
        "description": "Encourage subscription with bell icon animation",
        "background": "solid_dark",
        "cta_button": false,
        "music_intensity": "high",
        "social_icons": false,
        "bell_animation": true
      },
      {
        "name": "social_links",
        "description": "Display all social media links",
        "background": "brand_color",
        "cta_button": false,
        "music_intensity": "low",
        "social_icons": true
      },
      {
        "name": "minimal_credits",
        "description": "Simple text with music credits",
        "background": "fade_to_black",
        "cta_button": false,
        "music_intensity": "fade_out",
        "social_icons": false
      }
    ],
    "text_elements": {
      "main_cta": {
        "text": "Learn More",
        "font_size": 48,
        "color": "white",
        "background_color": "${PRIMARY_COLOR}",
        "padding": 16,
        "border_radius": 8
      },
      "website": {
        "text": "Visit: www.example.com",
        "font_size": 32,
        "color": "${SECONDARY_COLOR}"
      },
      "contact": {
        "text": "Contact: contact@example.com",
        "font_size": 24,
        "color": "white"
      }
    },
    "social_links": {
      "instagram": "https://instagram.com/yourhandle",
      "facebook": "https://facebook.com/yourpage",
      "tiktok": "https://tiktok.com/@yourhandle",
      "twitter": "https://twitter.com/yourhandle",
      "youtube": "https://youtube.com/@yourchannel"
    },
    "audio": {
      "music": {
        "duration": 2,
        "fade_out": 1.0,
        "genre": "uplifting_corporate"
      },
      "voiceover": {
        "enabled": false,
        "text": ""
      }
    },
    "logo": {
      "enabled": true,
      "position": "center",
      "size": "medium",
      "animation": "fade_in"
    },
    "button_animation": {
      "enabled": true,
      "type": "pulse",
      "speed": "medium"
    }
  }
}
